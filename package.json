{
  "name": "jiaozi-anime",
  "private": true,
  "version": "0.5.1",
  "description": "A local-first AI video shorts creation studio powered by Google Gemini models.",
  "license": "MIT",
  "author": "Jiaozi Anime Team",
  "keywords": [
    "ai",
    "video-generation",
    "gemini",
    "react",
    "local-first",
    "file-system-access-api",
    "creative-tool"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:extensions": "node scripts/build-extensions.cjs",
    "build": "npm run build:extensions && npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "docker:dev": "node scripts/docker-compose.mjs dev",
    "docker:up": "node scripts/docker-compose.mjs up",
    "docker:down": "node scripts/docker-compose.mjs down",
    "docker:logs": "node scripts/docker-compose.mjs logs",
    "build:release": "node scripts/build-release.mjs",
    "release:bootstrap": "node scripts/release-bootstrap.mjs",
    "release:upload": "node scripts/release-upload.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@heroui/react": "^2.8.7",
    "@types/three": "^0.184.0",
    "framer-motion": "^12.23.26",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "socket.io-client": "^4.8.3",
    "three": "^0.184.0",
    "undici": "^7.24.7",
    "yet-another-react-lightbox": "^3.28.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
