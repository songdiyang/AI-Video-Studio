PORT=4205
HOT_UPDATE_API_TOKEN=replace-with-a-long-random-token
HOT_UPDATE_SHARED_SECRET=replace-with-a-long-random-shared-secret
HOT_UPDATE_ALLOWED_CLOCK_SKEW_MS=300000
HOT_UPDATE_NONCE_TTL_MS=600000
HOT_UPDATE_UPLOAD_MAX_BYTES=734003200
HOT_UPDATE_KEEP_RELEASES=5

# 默认会写入仓库根目录下的 runtime/ 目录
# HOT_UPDATE_WORK_DIR=../runtime/hot-update
# HOT_UPDATE_FRONTEND_ROOT=../runtime/frontend
# HOT_UPDATE_BACKEND_ROOT=../runtime/backend

# 产物切换后需要重启后端进程
HOT_UPDATE_BACKEND_RESTART_CMD=docker compose --env-file docker-compose.env restart backend
